# ── Core ──────────────────────────────────────────────────────────────────────
PORTAL_ENV=development
PORTAL_BASE_URL=http://localhost:8000
PORTAL_SECRET_KEY=change-me-to-64-random-bytes
PORTAL_DATABASE_URL=sqlite+aiosqlite:///./data/portal.db

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be  {PORTAL_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated. Keep exactly these; they drive the Drive folder layout.
GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/drive.appdata

# ── Drive provider ───────────────────────────────────────────────────────────
# google = real Drive REST API (needs credentials above)
# mock   = offline filesystem-backed provider used for dev, tests and this repo
DRIVE_PROVIDER=mock
MOCK_DRIVE_ROOT=./data/mock_drive
# Parent folder in the *institutional* teacher account where submissions land.
TEACHER_DRIVE_ROOT_ID=root
INSTITUTION_EMAIL_DOMAIN=college.edu

# ── Academic integrity thresholds (0.00 - 1.00) ──────────────────────────────
# Anything at or above the threshold is flagged. Default policy: 50 %.
SIMILARITY_THRESHOLD=0.50
AI_DETECTION_THRESHOLD=0.50
# Minimum body length before we trust an AI score at all.
AI_DETECTION_MIN_WORDS=120

# ── Analysis pipeline (CPU bound; sized against the box) ─────────────────────
ANALYSIS_WORKERS=2
ANALYSIS_QUEUE_CAPACITY=5000
ANALYSIS_CPU_THREADS=2
SHINGLE_SIZE=5
MINHASH_PERMS=128
LSH_BANDS=32

# ── Uploads / limits ─────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
DRAFT_DEBOUNCE_MS=1500
RATE_LIMIT_PER_MINUTE=240
DRAFT_RATE_LIMIT_PER_MINUTE=1200
